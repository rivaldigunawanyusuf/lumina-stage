# ─────────────────────────────────────────────────────────────
# LuminaStage Environment Configuration Template
# Copy this file to .env.local and fill in your Meta AI API key.
# ─────────────────────────────────────────────────────────────

# --- META AI PRODUCTION CREDENTIALS ---
DEFAULT_PROVIDER_MODE=META_PROD
NEXT_PUBLIC_DEFAULT_PROVIDER_MODE=META_PROD
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_API_KEY=
META_SAM_MODEL=sam-3.1
META_SPARK_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0

# --- HARD COST GUARDRAIL (<$20.00 CAP) ---
MAX_META_SPEND_USD=18.00
META_COST_SAM_USD=0.02
META_COST_SPARK_USD=0.01
META_COST_IMAGE_USD=0.04

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
